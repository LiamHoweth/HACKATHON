# Still Here — environment template.
# Copy to .env.local (gitignored) and fill in values there. Never commit real keys.
# All variables are read server-side only (src/server/config.ts). None use the
# NEXT_PUBLIC_ prefix, so none are shipped to the browser.
#
# With the keys left empty, the app runs in explicitly labeled Fixture mode
# (canned demo suggestions) or Local-only mode (saved phrases + My words).
# Empty keys never pretend to be a live AI connection.
#
# Eyebrow NEXT and blink SELECT need no variables: MediaPipe runs in the
# browser from the local assets in public/models and public/wasm.
#
# Two separate keys, not interchangeable: OPENAI_API_KEY (replies and
# transcription) and ELEVENLABS_API_KEY (speech). Put values only in .env.local
# or Railway variables. Never paste a key into chat, docs, or a tracked file.

# --- Reply generation (live AI) ---------------------------------------------
# Live replies need all three: a provider, its key, and a model id.
# "openai" was verified live on 2026-10-24; "anthropic" is present but unverified.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Verified on 2026-10-24 against the key's model list: gpt-6-astra
REPLY_MODEL=gpt-6-astra
# Optional OpenAI reasoning effort (leave empty for the provider default).
REPLY_REASONING_EFFORT=
# Anthropic server-side refusal fallback (beta). Set to "off" to disable.
REPLY_FALLBACKS=default

# --- Partner speech transcription (optional) --------------------------------
# OpenAI-compatible /audio/transcriptions adapter. With provider=openai and no
# TRANSCRIPTION_API_KEY, OPENAI_API_KEY is used. Leave the provider empty to
# disable recording (typed partner input still works).
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_API_KEY=
# Verified on 2026-10-24 with a synthetic clip: gpt-transcribe
TRANSCRIPTION_MODEL=gpt-transcribe
# Optional; defaults to the OpenAI v1 base URL when empty.
TRANSCRIPTION_BASE_URL=

# --- Speech output: ElevenLabs (required primary voice) ---------------------
# Used only by the server route POST /api/speech, and only for a message the
# person has reviewed and separately confirmed. The key never reaches the
# browser. With the key or voice empty, the app reports the natural voice as
# "not configured" and offers only the explicitly labeled basic device voice.
# Status 2026-10-24 12:10 CT: adapter and route present but uncommitted and
# mock-tested only; no key configured yet, so live ElevenLabs speech is NOT
# verified. Adapter notes: src/server/elevenlabs/README.md
ELEVENLABS_API_KEY=
# A voice available to this account (find it via the authenticated voices API).
# ELEVENLABS_VOICE_ID is NOT the API key. Do not invent or commit a voice id.
ELEVENLABS_VOICE_ID=
# Preferred model per the brief. Any substitution must be documented.
ELEVENLABS_MODEL_ID=eleven_v4_turbo
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_MS=15000
# ws (default when empty) or http. eleven_v4_turbo always uses the
# Text-to-Dialogue WebSocket (never the standard TTS stream-input WebSocket);
# it has no documented HTTP route. http is for another ElevenLabs model, e.g.
# eleven_v4 (Text-to-Dialogue HTTP) or eleven_flash_v2_5 (standard TTS HTTP).
# Document any model substitution.
ELEVENLABS_TRANSPORT=
# Optional comma-separated allowlist of voice ids the server accepts from the
# client's voice choice. ELEVENLABS_VOICE_ID is always allowed.
ELEVENLABS_ALLOWED_VOICE_IDS=
# Server-side character budget per server process per UTC day (a spending
# guard, not a billing limit; also set a credit limit on the key in the
# ElevenLabs dashboard).
ELEVENLABS_DAILY_CHAR_BUDGET=20000

# --- Demo fixtures ----------------------------------------------------------
# Explicit, labeled fixture suggestions for demos/tests. Set to false to disable.
FIXTURES_ENABLED=true

# --- Budgets and bounds -----------------------------------------------------
GENERATION_TIMEOUT_MS=15000
TRANSCRIPTION_TIMEOUT_MS=20000
MAX_AUDIO_BYTES=4000000

# --- Access gate for paid endpoints -----------------------------------------
# When set, live /api requests must send this value in the x-still-here-access
# header; repeated wrong codes are throttled. When empty, any non-localhost
# request to a paid endpoint is refused. Set this before any non-local deployment.
APP_ACCESS_TOKEN=
