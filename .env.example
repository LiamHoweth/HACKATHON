# Still Here — environment template.
# Copy to .env.local (gitignored) and fill in values there. Never commit real keys.
# All variables are read server-side only (src/server/config.ts). None use the
# NEXT_PUBLIC_ prefix, so none are shipped to the browser.
#
# With everything left empty, the app runs in explicitly labeled Fixture mode
# (canned demo suggestions) or Local-only mode (saved phrases + My words).
# Empty configuration never pretends to be a live AI connection.

# --- Reply generation (live AI) ---------------------------------------------
# Live replies require all three: AI_PROVIDER=anthropic, a key, and a model id.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Suggested: claude-opus-5-5 (from the Claude API skill model table cached
# 2026-10-06). Confirm the model is available on your account before relying on it.
REPLY_MODEL=
# Server-side refusal fallback (beta). Set to "off" to disable.
REPLY_FALLBACKS=default

# --- Partner speech transcription (optional) --------------------------------
# OpenAI-compatible /audio/transcriptions adapter. Requires provider=openai,
# a key, and a model id. Leave empty to disable recording (typed input still works).
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
# Optional; defaults to the OpenAI v1 base URL when empty.
TRANSCRIPTION_BASE_URL=

# --- Demo fixtures ----------------------------------------------------------
# Explicit, labeled fixture suggestions for demos/tests. Set to false to disable.
FIXTURES_ENABLED=true

# --- Budgets and bounds -----------------------------------------------------
GENERATION_TIMEOUT_MS=15000
TRANSCRIPTION_TIMEOUT_MS=20000
MAX_AUDIO_BYTES=4000000

# --- Access gate for paid endpoints -----------------------------------------
# When set, /api requests must send this value in the x-still-here-access header.
# When empty, the request guard treats any non-localhost request to a paid
# endpoint as unprotected and refuses it. Set this before any non-local deployment.
APP_ACCESS_TOKEN=
